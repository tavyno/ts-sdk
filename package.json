{
    "name": "@tavyno/ts-sdk",
    "version": "0.1.0",
    "description": "Typed Tavyno REST API client for web and React Native",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "THIRD_PARTY_NOTICES"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tavyno/sdk.git"
    },
    "scripts": {
        "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/index.js",
        "test": "node --test tests/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "check": "npm run lint && npm run typecheck && npm run build && npm test",
        "prepack": "npm run build",
        "test:package": "npm run build && node scripts/test-package.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "oauth4webapi": "^3.8.8",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0"
    }
}
